---
import type { LocaleContent } from '../data/content';

interface Props {
  c: LocaleContent;
}

const { c } = Astro.props;
---

<section class="hero">
  <div class="container inner">
    <p class="eyebrow">{c.hero.eyebrow}</p>
    <h1>{c.hero.title}</h1>
    <p class="tagline">{c.hero.tagline}</p>
    <a class="btn" href="#contact">{c.hero.cta}</a>
  </div>
</section>

<style>
  .hero {
    padding-top: 7rem;
    padding-bottom: 7rem;
    background: radial-gradient(
        1200px 500px at 50% -10%,
        rgba(77, 163, 255, 0.18),
        transparent 60%
      ),
      var(--bg);
  }

  .inner {
    max-width: 760px;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
  }

  .tagline {
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    color: var(--text-muted);
    margin-bottom: 2rem;
    max-width: 620px;
  }
</style>
